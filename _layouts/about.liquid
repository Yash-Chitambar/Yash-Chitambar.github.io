---
layout: default
---
{% comment %}
  Local override of al_folio_core's about layout. The homepage is a single
  viewport: an ASCII black hole on canvas, the name bottom-left, nothing else.
{% endcomment %}
<script>
  document.documentElement.classList.add('is-home');
  if (typeof setThemeSetting === 'function') setThemeSetting('dark');
</script>

<section class="hero" aria-label="Home">
  <canvas class="hero-canvas" data-scene="blackhole" data-cell="3" data-counter="#hero-count" aria-hidden="true"></canvas>

  <div class="hero-text">
    <h1 class="hero-name">
      {% if site.title == 'blank' %}
        {{ site.first_name }}
        {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    {% if page.subtitle %}
      <p class="hero-line">{{ page.subtitle }}</p>
    {% endif %}
    <div class="hero-links">{{ content }}</div>
  </div>

  <p class="hero-caption" aria-hidden="true"><span class="num">[ 01 ]</span> schwarzschild · <span id="hero-count">0</span> particles</p>
</section>

<script src="{{ '/assets/js/dotfield.js' | relative_url | bust_file_cache }}"></script>
