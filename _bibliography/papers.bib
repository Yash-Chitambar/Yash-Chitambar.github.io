@article{chen2026manipulationnet,
  abbr        = {Sci. Robotics},
  bibtex_show = {true},
  title       = {ManipulationNet: An Infrastructure for Benchmarking Real-World Robot Manipulation with Physical Skill Challenges and Embodied Multimodal Reasoning},
  author      = {Chen, Yiting and Kimble, Kenneth and Adelson, Edward H. and Asfour, Tamim and Chanrungmaneekul, Podshara and Chitta, Sachin and Chitambar, Yash and Chen, Ziyang and Goldberg, Ken and Kragic, Danica and Li, Hui and Li, Xiang and Li, Yunzhu and Prather, Aaron and Pollard, Nancy and Roa-Garzon, Maximo A. and Seney, Robert and Sha, Shuo and Wang, Shihefeng and Xiang, Yu and Zhang, Kaifeng and Zhu, Yuke and Hang, Kaiyu},
  journal     = {Science Robotics},
  note        = {Accepted. Preprint: arXiv:2603.04363},
  year        = {2026},
  arxiv       = {2603.04363},
  abstract    = {ManipulationNet is a global infrastructure for benchmarking real-world robot manipulation, providing reproducible task setups through standardized hardware kits. It features two complementary evaluation tracks: a Physical Skills Track for assessing basic interaction capabilities, and an Embodied Reasoning Track for testing high-level reasoning with multimodal grounding. Distributed benchmarking is enabled through unified software interfaces to facilitate scalable real-world robot research.},
  selected    = {true}
}

@inproceedings{chen2026craft,
  abbr        = {ICRA},
  bibtex_show = {true},
  title       = {CRAFT: Long-Horizon Cable Routing Algorithm and Low-Friction Caging Gripper},
  author      = {Chen, Ziyang and Chitambar, Yash and Lam, Theodore and Li, Hui and Chitta, Sachin and Goldberg, Ken},
  booktitle   = {2026 IEEE International Conference on Robotics and Automation (ICRA)},
  address     = {Vienna, Austria},
  pages       = {5773--5780},
  year        = {2026},
  month       = jun,
  publisher   = {IEEE},
  doi         = {10.1109/ICRA57385.2026.11697170},
  pdf         = {craft_icra2026.pdf},
  website     = {https://manipulation-net.org/tasks/cable_routing.html},
  abstract    = {Cable routing is a common manipulation task in assembly and manufacturing, yet it remains challenging due to the deformable nature of cables and the constraints of cluttered routing environments. We present CRAFT: Cable Routing Around Fixtures using Two grippers, a novel hardware plus software architecture that integrates unimanual and bimanual operations for long-horizon cable routing. To address jamming due to friction, we present a novel caging gripper with roller mechanism. Physical experiments consisting of 160 trials on a modified NIST board with five types of fixtures and turning angle up to 930 degrees yielded an average completion ratio of 84.5% across four routing difficulty tiers, representing a 54.2% improvement over an earlier baseline.},
  selected    = {true}
}
