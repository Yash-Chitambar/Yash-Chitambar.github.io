{% comment %}
  Local override of al_folio_core's project card: one plain row per project.
{% endcomment %}
<a class="project-row" href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
  <span class="project-date">
    {%- if project.date %}{{ project.date | date: '%Y.%m' }}{% endif -%}
  </span>
  <span class="project-main">
    <span class="project-title">{{ project.title }}</span>
    <span class="project-desc">{{ project.description }}</span>
  </span>
  <span class="project-arrow" aria-hidden="true">→</span>
</a>
